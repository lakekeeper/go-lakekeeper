{
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "release-type": "go",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "pkg/version/version.go"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "hidden": false,
          "section": "Features"
        },
        {
          "type": "fix",
          "hidden": false,
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "hidden": false,
          "section": "Performance Improvements"
        },
        {
          "type": "revert",
          "hidden": false,
          "section": "Reverts"
        },
        {
          "type": "docs",
          "hidden": false,
          "section": "Documentation"
        },
        {
          "type": "chore",
          "hidden": false,
          "section": "Miscellaneous Chores"
        },
        {
          "type": "build",
          "hidden": false,
          "section": "Miscellaneous Chores"
        },
        {
          "type": "ci",
          "hidden": false,
          "section": "Miscellaneous Chores"
        },
        {
          "type": "refactor",
          "hidden": false,
          "section": "Miscellaneous Chores"
        },
        {
          "type": "style",
          "hidden": false,
          "section": "Miscellaneous Chores"
        },
        {
          "type": "test",
          "hidden": false,
          "section": "Miscellaneous Chores"
        }
      ]
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}