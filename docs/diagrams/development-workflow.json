  "cards": [
    {
      "dot": "cyan",
      "title": "Which tests need the compose stack",
      "items": [
        "make validate, make test and make build need no stack",
        "make test-integration and make test-e2e-compose start the compose stack and tear it down; KEEP_STACK=1 leaves it running",
        "make test-e2e-kind runs only the auth-only subset on a kind cluster; CI runs it on every PR",
        "make test-plus runs the Lakekeeper+ suites with the Lakekeeper+ image; the license is optional for local test runs, CI runs them on main with one",
        "make test-e2e-versions pins Lakekeeper to the oldest supported minor and the one before it; CI does not run it"
      ]
    },
    {
      "dot": "amber",
      "title": "Outside ci-ok",
      "items": [
        "spec breaking changes reports on PRs that change a spec and never fails",
        "e2e-plus runs on pushes to main only, where the license secret is"
      ]
    },
    {
      "dot": "rose",
      "title": "Owned by release-please",
      "items": [
        "The PR title becomes the squash commit that release-please reads",
        "CHANGELOG.md and .release-please-manifest.json are written by release-please; leave them untouched"
      ]
    }
  ]
