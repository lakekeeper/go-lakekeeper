  "cards": [
    {
      "dot": "rose",
      "title": "To change generated code",
      "items": [
        "Change the spec, the postprocessor or the generator config, then run make generate",
        "make generate deletes pkg/apis/management/v1 before each run, so hand edits are lost",
        "Commit the spec update and the regenerated tree in the same commit"
      ]
    },
    {
      "dot": "cyan",
      "title": "Generator config",
      "items": [
        "Lists only the options whose value differs from openapi-generator's default",
        "Each option has an inline comment saying why it deviates",
        "Don't add an option set to its default value"
      ]
    },
    {
      "dot": "slate",
      "title": "Postprocessor",
      "items": [
        "Removes decoder.DisallowUnknownFields() from model UnmarshalJSON, so new server fields decode",
        "Rewrites enum UnmarshalJSON to keep an unknown value instead of failing",
        "Leaves the required-field check and discriminator dispatch alone"
      ]
    }
  ]
