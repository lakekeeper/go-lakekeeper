  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "A user belongs to the server, never to a project; it holds assignments there",
        "A role and a warehouse each belong to one project",
        "The server picks the default project when a call sends none"
      ]
    },
    {
      "dot": "violet",
      "title": "Role on both sides",
      "items": [
        "As a principal, a role is given assignments on any resource",
        "As a resource, a role has users and other roles assigned to it (assignee, ownership)"
      ]
    },
    {
      "dot": "amber",
      "title": "Permission façades",
      "items": [
        "c.Permissions.Server, .Projects, .Warehouses and .Roles: one per resource kind",
        "Each offers Access, Assignments, Grant and Revoke",
        "Namespace, table and view have no façade yet, so they are left out"
      ]
    }
  ]
