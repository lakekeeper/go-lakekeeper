# graphify knowledge graph: union-merge with the graphify driver (`make graph-setup`),
# collapse in GitHub PRs, and keep it out of `git diff`.
graphify-out/graph.json merge=graphify linguist-generated=true -diff

# Diagram renders: generated by `make diagrams-render` from docs/diagrams/*.json; collapse in GitHub PRs.
docs/diagrams/*.html linguist-generated=true
docs/diagrams/*.svg linguist-generated=true
